{
  "name": "mdtg - Node 24",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "stryker-mutator.stryker-mutator"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "files.eol": "\n"
      }
    }
  }
}
