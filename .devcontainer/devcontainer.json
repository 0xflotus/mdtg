{
  "name": "mdtg - Node 24",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash -lc 'source \"$NVM_DIR/nvm.sh\" && nvm install && nvm use' && npm clean-install",
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "stryker-mutator.stryker-mutator"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "files.eol": "\n"
      }
    }
  }
}
