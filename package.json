{
  "name": "mdtg",
  "version": "4.1.5",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "coverage": "vitest run --coverage",
    "format": "biome check .",
    "knip": "knip",
    "prelint": "npm run format && npm run prettier",
    "lint": "biome lint .",
    "prettier": "prettier **/*.yml",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "keywords": [
    "military",
    "date",
    "date time group",
    "dtg",
    "time"
  ],
  "author": "0xflotus",
  "license": "MIT",
  "description": "This package offers you methods to convert Date Objects to military date time group and vice versa",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "vitest": "^4.1.11"
  }
}
