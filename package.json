{
  "name": "mdtg",
  "version": "4.1.10",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "coverage": "vitest run --coverage",
    "format": "biome check .",
    "knip": "knip",
    "prelint": "npm run format && npm run prettier",
    "lint": "biome lint .",
    "prettier": "prettier **/*.yml",
    "test": "vitest run",
    "test:gherkin": "vitest run test/features",
    "test:integration": "vitest run test/integration",
    "test:mutation": "stryker run"
  },
  "keywords": [
    "military",
    "date",
    "date time group",
    "dtg",
    "time"
  ],
  "author": "0xflotus",
  "license": "MIT",
  "description": "This package offers you methods to convert Date Objects to military date time group and vice versa",
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@biomejs/biome": "2.5.15",
    "@systemfsoftware/stryker-js": "17.0.2",
    "@systemfsoftware/stryker-js-vitest-runner": "8.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "knip": "6.40.0",
    "prettier": "3.9.9",
    "vitest": "5.0.3"
  }
}
