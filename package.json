{
  "name": "mdtg",
  "version": "5.3.4",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "coverage": "vitest run --coverage",
    "format": "biome check .",
    "knip": "knip",
    "lint": "biome lint .",
    "prettier": "prettier **/*.yml",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration",
    "test:gherkin": "vitest run --project behavior",
    "test:mutation": "stryker run"
  },
  "keywords": [
    "military",
    "date",
    "date time group",
    "dtg",
    "time"
  ],
  "author": "0xflotus",
  "license": "MIT",
  "description": "This package offers you methods to convert Date Objects to military date time group and vice versa",
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@biomejs/biome": "2.6.7",
    "@systemfsoftware/stryker-js": "17.0.2",
    "@systemfsoftware/stryker-js-vitest-runner": "8.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "knip": "6.45.1",
    "prettier": "3.10.0",
    "vitest": "5.1.0"
  }
}
